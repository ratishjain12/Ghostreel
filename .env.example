# S3 bucket the dashboard's Upload button pushes video/<name>/resources/guide.pdf into,
# and where infra/lambda/handler.py reads triggers.json + guide.pdf from.
S3_BUCKET=

# AWS credentials — omit these if you're using an ~/.aws/credentials profile instead
# (boto3 picks that up automatically; these env vars are only needed otherwise).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Dashboard's Schedule tab — one-shot EventBridge Scheduler + Lambda publish, so a
# scheduled post fires on time even if this machine is asleep/off at that moment.
# After `sam deploy` (infra/template.yaml), copy these three from the stack outputs.
# The identity this dashboard runs as also needs the DashboardOperatorPolicy output
# attached (scheduler:*Schedule + iam:PassRole + table/S3 access).
SCHEDULE_TABLE=
SCHEDULE_LAMBDA_ARN=
SCHEDULER_ROLE_ARN=

# Dashboard's Performance tab — reads real Instagram insights (reach, likes, etc.)
# per published post, plus trigger-conversion counts the webhook Lambda writes to
# this same table (stack output SentMarkersTableName). Reuses the same IG access
# token/user-id SSM params the webhook and publish scripts already use.
TRIGGER_STATS_TABLE=
IG_USER_ID_PARAM=/content-studio/ig-user-id
IG_ACCESS_TOKEN_PARAM=/content-studio/ig-access-token

# Competitor research (scripts/scrape_competitors.py) — a Facebook Login token, since
# business_discovery doesn't exist on the Instagram Login API. See docs/meta-app-setup.md § 7b.
IG_FB_ACCESS_TOKEN_PARAM=/content-studio/ig-fb-access-token
IG_FB_USER_ID_PARAM=/content-studio/ig-fb-user-id

# Dashboard's token panel + "Reconnect Facebook" button (Performance tab). App id and
# the MAIN app secret (App settings → Basic), plus the Facebook Login for Business
# configuration id (Facebook Login for Business → Configurations).
FB_APP_ID=
FB_APP_SECRET_PARAM=/content-studio/fb-app-secret
FB_LOGIN_CONFIG_ID=
