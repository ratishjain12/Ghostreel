# S3 bucket the dashboard's Upload button pushes video/<name>/resources/guide.pdf into,
# and where infra/lambda/handler.py reads triggers.json + guide.pdf from.
S3_BUCKET=

# AWS credentials — omit these if you're using an ~/.aws/credentials profile instead
# (boto3 picks that up automatically; these env vars are only needed otherwise).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
